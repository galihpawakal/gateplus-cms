# Local PostgreSQL settings for optional Docker Compose
POSTGRES_USER=gateplus
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=gateplus_cms
DB_PORT=5432

# Application and migration connections (same URL for local PostgreSQL)
DATABASE_URL="postgresql://gateplus:change_me_locally@localhost:5432/gateplus_cms?schema=public"
DIRECT_URL="postgresql://gateplus:change_me_locally@localhost:5432/gateplus_cms?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth client settings (publishable key is safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key