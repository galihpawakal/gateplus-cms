generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Content {
  id            String   @id @default(cuid())
  title         String
  description   String
  genre         String
  thumbnailUrl  String?
  status        Status   @default(draft)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([genre])
  @@index([publishedAt])
}

enum Status {
  draft
  published
}